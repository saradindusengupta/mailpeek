{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run MailPeek Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extension", "${workspaceFolder}/data"],
      "outFiles": ["${workspaceFolder}/extension/out/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    }
  ]
}
