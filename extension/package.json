{
  "name": "mailpeek",
  "displayName": "MailPeek",
  "description": "View .msg and .eml files, including nested forwarded emails, without leaving the editor.",
  "version": "0.0.1",
  "publisher": "nullgradlabs",
  "author": {
    "name": "Saradindu Sengupta",
    "email": "saradindu@nullgradlabs.com"
  },
  "license": "GPL-3.0-only",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "email",
    "msg",
    "eml",
    "outlook",
    "viewer",
    "mail",
    "message",
    "attachments"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/saradindusengupta/mailpeek.git"
  },
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "mailpeek.emailViewer",
        "displayName": "Email Viewer",
        "selector": [
          {
            "filenamePattern": "*.msg"
          },
          {
            "filenamePattern": "*.eml"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "MailPeek",
      "properties": {
        "mailpeek.collapseQuotedText": {
          "type": "boolean",
          "default": true,
          "description": "Collapse quoted/forwarded content (Original Message markers, On...wrote: replies, and HTML blockquotes) behind a toggle so long forward chains are readable by default."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:extension && npm run compile:webview",
    "compile:extension": "tsc -p tsconfig.json",
    "compile:webview": "node esbuild.js",
    "watch": "concurrently \"tsc -p tsconfig.json --watch\" \"node esbuild.js --watch\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "lint": "eslint src",
    "pretest": "npm run compile",
    "test": "node out/test/runTest.js",
    "license-check": "license-checker --production --excludePackages \"mailpeek@0.0.1\" --failOn \"GPL-1.0-only;GPL-1.0-or-later;GPL-2.0-only;GPL-2.0-or-later;GPL-3.0-only;GPL-3.0-or-later;AGPL-1.0-only;AGPL-1.0-or-later;AGPL-3.0-only;AGPL-3.0-or-later;LGPL-2.0-only;LGPL-2.0-or-later;LGPL-2.1-only;LGPL-2.1-or-later;LGPL-3.0-only;LGPL-3.0-or-later;SSPL-1.0;UNLICENSED\"",
    "package": "npm run license-check && node -e \"require('fs').copyFileSync('../README.md','README.md')\" && vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "concurrently": "^8.2.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.9.0",
    "glob": "^11.0.0",
    "license-checker": "^25.0.1",
    "mocha": "^10.7.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.1"
  },
  "dependencies": {
    "@kenjiuno/decompressrtf": "^0.1.3",
    "@kenjiuno/msgreader": "^1.28.0",
    "dompurify": "^3.1.6",
    "iconv-lite": "^0.7.3",
    "postal-mime": "^3.0.0",
    "rtf-stream-parser": "^3.7.9"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
